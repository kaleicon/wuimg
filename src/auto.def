/* Enumerate formats for autodec
 * Format: WUDEC(base_name, description) */
WUDEC(avs, "AVS X")
WUDEC(bru, "Degas Brush")
WUDEC(gemview, "GEM View-Dither")
WUDEC(farbfeld, "farbfeld")
WUDEC(hpicon, "HP Palmtop Icon")
WUDEC(nlm, "Nokia Logo Manager")

// Atari Falcon True Color
WUDEC(coke, "COKE (Atari Falcon)")
WUDEC(ftc, "Falcon True Color")
WUDEC(eggpaint, "EggPaint")
WUDEC(god, "GodPaint")
WUDEC(indy, "IndyPaint")
WUDEC(trp, "Spooky Sprites uncompressed")

// Atari ST High Resolution
WUDEC(da4, "PaintShop (Atari ST)")
WUDEC(doo, "Atari Doodle")
